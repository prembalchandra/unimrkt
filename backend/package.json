{
  "name": "unimrkt-strapi-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Strapi 5 Headless CMS Backend for Unimrkt Research",
  "scripts": {
    "dev": "node ./node_modules/@strapi/strapi/bin/strapi.js develop --no-build-admin --no-watch-admin",
    "develop": "node ./node_modules/@strapi/strapi/bin/strapi.js develop --no-build-admin --no-watch-admin",
    "start": "node ./node_modules/@strapi/strapi/bin/strapi.js start",
    "build": "node ./node_modules/@strapi/strapi/bin/strapi.js build",
    "strapi": "node ./node_modules/@strapi/strapi/bin/strapi.js"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "^5.0.0",
    "@strapi/strapi": "^5.0.0",
    "better-sqlite3": "^11.3.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.1.13"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=6.0.0"
  },
  "license": "MIT"
}
