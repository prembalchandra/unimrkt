{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global Settings",
    "description": "Global website configuration, branding, navigation, and footer settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "default": "Unimrkt Research"
    },
    "siteDescription": {
      "type": "text",
      "default": "Structured Market Intelligence & Data Analytics"
    },
    "headerLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "footerLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "navigation": {
      "type": "component",
      "repeatable": true,
      "component": "elements.nav-link"
    },
    "headerCta": {
      "type": "component",
      "repeatable": false,
      "component": "elements.button-link"
    },
    "footerDescription": {
      "type": "text",
      "default": "Delivering global market research, data collection, and actionable insights that drive smarter business decisions."
    },
    "footerCertificationLogos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "layout.footer-column"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "elements.social-link"
    },
    "copyrightText": {
      "type": "string",
      "default": "© 2026 Unimrkt Research. All rights reserved."
    },
    "legalLinks": {
      "type": "component",
      "repeatable": true,
      "component": "elements.button-link"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
