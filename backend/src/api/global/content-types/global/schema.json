{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global Settings",
    "description": "Global website configuration, branding, navigation, and footer settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "default": "Unimrkt Research"
    },
    "siteDescription": {
      "type": "text",
      "default": "Structured Market Intelligence & Data Analytics"
    },
    "headerLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "footerLogo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "navigation": {
      "type": "component",
      "repeatable": true,
      "component": "elements.nav-link"
    },
    "headerCta": {
      "type": "component",
      "repeatable": false,
      "component": "elements.button-link"
    },
    "footerDescription": {
      "type": "text",
      "default": "Delivering global market research, data collection, and actionable insights that drive smarter business decisions."
    },
    "footerCertificationLogos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "layout.footer-column"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "elements.social-link"
    },
    "copyrightText": {
      "type": "string",
      "default": "© 2026 Unimrkt Research. All rights reserved."
    },
    "contactPhone": {
      "type": "string",
      "default": "+91-124-400-8800"
    },
    "contactEmail": {
      "type": "string",
      "default": "info@unimrkt.com"
    },
    "contactAddress": {
      "type": "text",
      "default": "Unimrkt Research, 5th Floor, Tower B, Unitech Cyber Park, Sector 39, Gurugram, Haryana 122002"
    },
    "contactWorkingHours": {
      "type": "string",
      "default": "Mon - Fri: 9:00 AM - 6:00 PM IST"
    },
    "topNotificationBar": {
      "type": "string"
    },
    "legalLinks": {
      "type": "component",
      "repeatable": true,
      "component": "elements.button-link"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
